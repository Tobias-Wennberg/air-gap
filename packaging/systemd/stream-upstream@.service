[Unit]
Description=Air Gap Upstream Service - Kafka to UDP Sender
Documentation=https://github.com/anders-wartoft/air-gap
Documentation=file:///usr/share/doc/stream-upstream/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=stream
Group=stream

# Working directory for relative paths in config
WorkingDirectory=/etc/stream

# Main execution
ExecStart=/usr/local/bin/stream-upstream /etc/stream/upstream-%i.properties

# Environment file (optional overrides)
EnvironmentFile=-/etc/default/stream-upstream

# Restart behavior
Restart=on-failure
RestartSec=10

# Resource limits
LimitNOFILE=65536
MemoryMax=1G

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=stream-upstream

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/stream/upstream /var/log/stream

[Install]
WantedBy=multi-user.target
