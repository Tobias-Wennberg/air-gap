[Unit]
Description=Air Gap Downstream Service - UDP to Kafka Receiver
Documentation=https://github.com/anders-wartoft/air-gap
Documentation=file:///usr/share/doc/stream-downstream/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=stream
Group=stream

# Working directory for relative paths in config
WorkingDirectory=/etc/stream

# Main execution
ExecStart=/usr/local/bin/stream-downstream /etc/stream/downstream-%i.properties

# Environment file (optional overrides)
EnvironmentFile=-/etc/default/stream-downstream

# Restart behavior
Restart=on-failure
RestartSec=10

# Resource limits
LimitNOFILE=65536
MemoryMax=1G

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=stream-downstream

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/stream/downstream /var/log/stream

[Install]
WantedBy=multi-user.target
